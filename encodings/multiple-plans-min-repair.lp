%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Multiple-plans repair encoding (one problem, N input example plans).
%
% Every input plan is its own PLAN, identified by a plan id P. All dynamic
% predicates carry P (holds/4, occurs/3, caused/4, modified/3, time/2), so the
% plans never share state. The domain facts (from plasp) and the repair layer
% (applied_*/enabled) are GLOBAL so one repair set must satisfy every plan at once.
%
% Each path is tagged by its kind:
%   * positive_example(P) -- a plan to preserve. Its given actions are kept and
%     the rest (up to its horizon) may be completed.
%   * negative_example(P) -- a plan to block. Its prefix must stay applicable
%     while its last action is forced inapplicable. No completion, no goal.
%     
% Per-plan info is generated by multi_plan.py
% Each plan's timeline time(0..H,P) is derived from horizon(P,H), so there is no
% global horizon constant. The domain/problem facts come from plasp.
% The repair candidates come from repair_candidates.py.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#const max_repairs=1.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Establish initial state
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Establish the initial state of every path (one copy per path).
holds(Variable, Value, 0, P) :- initialState(Variable, Value), plan(P).

plan(P) :- positive_example(P).
plan(P) :- negative_example(P).

time(0..H, P) :- horizon(P, H).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Compute derived predicates
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% STRIPS only -- derived predicates / axioms are not handled here.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Perform actions 
% 	Each is applied in its own plan (P)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Action completion is only allowed for positive examples
1 {occurs(Action, T, P) : action(Action)} 1 :- positive_example(P), time(T, P), T > 0.

% Check preconditions (reads applied_precondition instead of precondition)
:- occurs(Action, T, P), applied_precondition(Action, Variable, Value),
	not holds(Variable, Value, T - 1, P).

% Apply effects (reads applied_postcondition).
caused(Variable, Value, T, P) :-
	occurs(Action, T, P),
	applied_postcondition(Action, Effect, Variable, Value),
	holds(VariablePre, ValuePre, T - 1, P) : applied_postcondition(Effect, VariablePre, ValuePre).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Inertia rules
% 	Associated to P
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

modified(Variable, T, P) :- caused(Variable, Value, T, P).

holds(Variable, Value, T, P) :- caused(Variable, Value, T, P).
holds(variable(V), Value, T, P) :-
	holds(variable(V), Value, T - 1, P), not modified(variable(V), T, P), time(T, P).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Variables and mutex groups
% 	Associated to P
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Each variable has a unique value at each step of each plan.
:- variable(Variable), plan(P),
	not 1 {holds(Variable, Value, T, P) : contains(Variable, Value)} 1, time(T, P).

% Mutex groups hold at each step of each plan.
:- mutexGroup(MutexGroup), plan(P),
	not {holds(Variable, Value, T, P) : contains(MutexGroup, Variable, Value)} 1, time(T, P).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Verify that goal is met
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Goals are only achieved by positive examples
% Negative examples only needs the prefix to run and the last action blocked, not the goal.
:- positive_example(P), goal(Variable, Value), not holds(Variable, Value, H, P), horizon(P, H).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Repair layer (NO plan index - One repair shared by every plan)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% With no repairs enabled, applied_ == plasp.
applied_precondition(Action, Variable, Value) :-
	precondition(Action, Variable, Value), not deleted_precondition(Action, Variable, Value).

applied_precondition(Action, Variable, Value) :-
	added_precondition(Action, Variable, Value).

applied_postcondition(Action, Effect, Variable, Value) :-
	postcondition(Action, Effect, Variable, Value), not deleted_postcondition(Action, Effect, Variable, Value).

applied_postcondition(Action, effect(unconditional), Variable, Value) :-
	added_effect(Action, Variable, Value).

% minimize the total cost of enabled repairs
{enabled(R) : repair(R)}.
#minimize {C,R : enabled(R), repair_cost(R, C)}.

#show enabled/1.
#show occurs/3.

% The domain-specific repair(...) candidate facts generated by repair_candidates.py
% and the plasp domain/problem facts are concatenated after this encoding.