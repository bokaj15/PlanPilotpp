%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Multiple-plans repair encoding (one problem, N input plans).
%
% Every input plan is its own PATH, identified by a plan id P. All dynamic
% predicates carry P (holds/4, occurs/3, caused/4, modified/3, time/2), so the
% paths never share state. The domain facts (from plasp) and the repair layer
% (applied_*/enabled) are GLOBAL -- the single coupling point -- so one repair
% set must satisfy every path at once.
%
% The per-plan facts (plan/1, time/2, occurs/3) and the per-plan terminal
% constraints (reach the goal for a whitelist, block the last action for a
% blacklist) are generated by multi_plan.py. The domain/problem facts come from
% plasp; the repair(...) candidates and their bridge rules from
% repair_candidates.py. Each plan carries its own horizon as time(0..len,P), so
% there is no global horizon constant.
%
% NOTE: STRIPS only -- derived predicates / axioms are not handled here.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#const max_repairs=1.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Per-path state (indexed by plan P)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Establish the initial state of every path (same init, one copy per path).
holds(Variable, Value, 0, P) :- initialState(Variable, Value), plan(P).

% Apply effects (reads applied_postcondition so repairs are visible).
caused(Variable, Value, T, P) :-
	occurs(Action, T, P),
	applied_postcondition(Action, Effect, Variable, Value),
	holds(VariablePre, ValuePre, T - 1, P) : applied_postcondition(Effect, VariablePre, ValuePre).

modified(Variable, T, P) :- caused(Variable, Value, T, P).

holds(Variable, Value, T, P) :- caused(Variable, Value, T, P).
holds(variable(V), Value, T, P) :-
	holds(variable(V), Value, T - 1, P), not modified(variable(V), T, P), time(T, P).

% Every pinned action must be applicable in its own path.
:- occurs(Action, T, P), applied_precondition(Action, Variable, Value),
	not holds(Variable, Value, T - 1, P).

% Each variable has a unique value at each step of each path.
:- variable(Variable), plan(P),
	not 1 {holds(Variable, Value, T, P) : contains(Variable, Value)} 1, time(T, P).

% Mutex groups hold at each step of each path.
:- mutexGroup(MutexGroup), plan(P),
	not {holds(Variable, Value, T, P) : contains(MutexGroup, Variable, Value)} 1, time(T, P).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Shared repair layer (NO plan index -- one repair set seen by every path)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% With no repairs enabled, applied_ == plasp.
applied_precondition(Action, Variable, Value) :-
	precondition(Action, Variable, Value), not deleted_precondition(Action, Variable, Value).

applied_precondition(Action, Variable, Value) :-
	added_precondition(Action, Variable, Value).

applied_postcondition(Action, Effect, Variable, Value) :-
	postcondition(Action, Effect, Variable, Value), not deleted_postcondition(Action, Effect, Variable, Value).

applied_postcondition(Action, effect(unconditional), Variable, Value) :-
	added_effect(Action, Variable, Value).

% choose at most max_repairs repairs
{enabled(R) : repair(R)} max_repairs.

#show enabled/1.
#show occurs/3.

% The domain-specific repair(...) candidate facts and their bridge rules, the
% per-plan facts, and the plasp domain/problem facts are concatenated after this
% encoding.

%%%%%%% multiple plans encoding
% path w1: whitelist -- must reach the goal at step 8
plan(w1).
time(0..8,w1).
occurs(action(("load-truck", constant("package1"), constant("truck1"), constant("city-1"))),1,w1).
occurs(action(("drive-truck", constant("truck1"), constant("city-1"), constant("city-2"))),2,w1).
occurs(action(("unload-truck", constant("package1"), constant("truck1"), constant("city-2"))),3,w1).
occurs(action(("load-airplane", constant("package2"), constant("plane1"), constant("city-2"))),4,w1).
occurs(action(("load-airplane", constant("package1"), constant("plane1"), constant("city-2"))),5,w1).
occurs(action(("fly-airplane", constant("plane1"), constant("city-2"), constant("city-6"))),6,w1).
occurs(action(("unload-airplane", constant("package2"), constant("plane1"), constant("city-6"))),7,w1).
occurs(action(("unload-airplane", constant("package1"), constant("plane1"), constant("city-6"))),8,w1).
:- goal(V,Val), not holds(V,Val,8,w1).

% path b1: blacklist -- forbid the last action at step 1
plan(b1).
time(0..1,b1).
occurs(action(("drive-truck", constant("truck1"), constant("city-1"), constant("city-2"))),1,b1).
:- holds(Variable, Value, 1, b1) : applied_precondition(action(("load-truck", constant("package1"), constant("truck1"), constant("city-2"))), Variable, Value).


% repair candidates for load-truck
repair(add_precondition("load-truck", ("airport-in", par3), true)).
added_precondition(action(("load-truck", X1, X2, X3)), variable(("airport-in", X3)), value(variable(("airport-in", X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_precondition("load-truck", ("airport-in", par3), true)).
repair(add_precondition("load-truck", ("at", par1, par3), true)).
added_precondition(action(("load-truck", X1, X2, X3)), variable(("at", X1, X3)), value(variable(("at", X1, X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_precondition("load-truck", ("at", par1, par3), true)).
repair(add_precondition("load-truck", ("in", par1, par2), true)).
added_precondition(action(("load-truck", X1, X2, X3)), variable(("in", X1, X2)), value(variable(("in", X1, X2)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_precondition("load-truck", ("in", par1, par2), true)).
repair(delete_precondition("load-truck", ("at", par2, par3), true)).
deleted_precondition(action(("load-truck", X1, X2, X3)), variable(("at", X2, X3)), value(variable(("at", X2, X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(delete_precondition("load-truck", ("at", par2, par3), true)).
repair(add_effect("load-truck", ("airport-in", par3), true)).
added_effect(action(("load-truck", X1, X2, X3)), variable(("airport-in", X3)), value(variable(("airport-in", X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_effect("load-truck", ("airport-in", par3), true)).
repair(delete_effect("load-truck", ("in", par1, par2), true)).
deleted_postcondition(action(("load-truck", X1, X2, X3)), effect(unconditional), variable(("in", X1, X2)), value(variable(("in", X1, X2)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(delete_effect("load-truck", ("in", par1, par2), true)).

