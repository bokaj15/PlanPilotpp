#const horizon=1.
#const max_repairs=1.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Horizon, must be defined externally
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

time(0..horizon).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Establish initial state
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

holds(Variable, Value, 0) :- initialState(Variable, Value).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Compute derived predicates
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% conjunctive preconditions
satisfied(DerivedPredicate, type(and), T) :- derivedPredicate(DerivedPredicate, type(and)), holds(Variable, Value, T) : precondition(DerivedPredicate, type(and), Variable, Value); time(T).

% disjunctive preconditions
satisfied(DerivedPredicate, type(or), T) :- precondition(DerivedPredicate, type(or), Variable, Value), holds(Variable, Value, T), time(T).

holds(DerivedVariable, Value, T) :- satisfied(DerivedPredicate, Type, T), postcondition(DerivedPredicate, Type, effect(unconditional), DerivedVariable, Value).

holds(derivedVariable(DerivedVariable), value(DerivedVariable, false), T) :- derivedVariable(DerivedVariable), not holds(derivedVariable(DerivedVariable), value(DerivedVariable, true), T), time(T).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Perform actions
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

0 {occurs(Action, T) : action(Action)} 1 :- time(T), T > 0.

% Check preconditions (repaired: reads applied_precondition instead of precondition)
:- occurs(Action, T), applied_precondition(Action, Variable, Value), not holds(Variable, Value, T - 1).

% Apply effects (repaired: reads applied_postcondition instead of postcondition)
caused(Variable, Value, T) :-
	occurs(Action, T),
	applied_postcondition(Action, Effect, Variable, Value),
	holds(VariablePre, ValuePre, T - 1) : applied_postcondition(Effect, VariablePre, ValuePre).

% Repairs 
% With no repairs enabled, applied_ == plasp
applied_precondition(Action, Variable, Value) :-
	precondition(Action, Variable, Value), not deleted_precondition(Action, Variable, Value).

applied_precondition(Action, Variable, Value) :-
	added_precondition(Action, Variable, Value).

applied_postcondition(Action, Effect, Variable, Value) :-
	postcondition(Action, Effect, Variable, Value), not deleted_postcondition(Action, Effect, Variable, Value).

applied_postcondition(Action, effect(unconditional), Variable, Value) :-
	added_effect(Action, Variable, Value).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Inertia rules
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

modified(Variable, T) :- caused(Variable, Value, T).

holds(Variable, Value, T) :- caused(Variable, Value, T).
holds(variable(V), Value, T) :- holds(variable(V), Value, T - 1), not modified(variable(V), T), time(T).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Variables and mutex groups
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Check that variables have unique values
:- variable(Variable), not 1 {holds(Variable, Value, T) : contains(Variable, Value)} 1, time(T).

% Check mutexes
:- mutexGroup(MutexGroup), not {holds(Variable, Value, T) : contains(MutexGroup, Variable, Value)} 1, time(T).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Verify that goal is met
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

:- goal(Variable, Value), not holds(Variable, Value, horizon).

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Repair
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% The domain-specific repair(...) candidate facts and their bridge rules are
% generated by repair_candidates.py and concatenated after this encoding.

% choose at most max_repairs repairs
{enabled(R) : repair(R)} max_repairs.

#show enabled/1.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Shows all 'occurs' atoms.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#show occurs/2.
%%%%%%% partial plan encoding
:- not occurs(action(("load-truck",constant("package3"),constant("truck1"),constant("city1-1"))),1).
:- not occurs(action(("drive-truck",constant("truck1"),constant("city1-1"),constant("city1-2"))),2).
:- not occurs(action(("drive-truck",constant("truck1"),constant("city1-2"),constant("city4-2"))),3).
:- not occurs(action(("load-truck",constant("package1"),constant("truck1"),constant("city4-2"))),4).
:- not occurs(action(("drive-truck",constant("truck1"),constant("city4-2"),constant("city6-2"))),5).
:- not occurs(action(("drive-truck",constant("truck1"),constant("city6-2"),constant("city6-1"))),6).
:- not occurs(action(("unload-truck",constant("package3"),constant("truck1"),constant("city6-1"))),7).
:- not occurs(action(("unload-truck",constant("package1"),constant("truck1"),constant("city6-1"))),8).

%%%%%%% blacklist plan encoding
% blacklist: forbidden action and the state it must not be applicable in
forbidden_action(action(("load-truck", constant("package1"), constant("truck1"), constant("city6-1")))).

observed_state(variable(("airport", constant("city6-1"))), value(variable(("airport", constant("city6-1"))), true)).
observed_state(variable(("at", constant("package1"), constant("city6-1"))), value(variable(("at", constant("package1"), constant("city6-1"))), false)).
observed_state(variable(("at", constant("truck1"), constant("city6-1"))), value(variable(("at", constant("truck1"), constant("city6-1"))), true)).
observed_state(variable(("in", constant("package1"), constant("truck1"))), value(variable(("in", constant("package1"), constant("truck1"))), false)).
observed_state(variable(("road", constant("city6-1"), constant("city6-1"))), value(variable(("road", constant("city6-1"), constant("city6-1"))), false)).

:- forbidden_action(Action), observed_state(Variable, Value) : applied_precondition(Action, Variable, Value).

% repair candidates for load-truck
repair(add_precondition("load-truck", ("airport", par3), true)).
added_precondition(action(("load-truck", X1, X2, X3)), variable(("airport", X3)), value(variable(("airport", X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_precondition("load-truck", ("airport", par3), true)).
repair(add_precondition("load-truck", ("in", par1, par2), true)).
added_precondition(action(("load-truck", X1, X2, X3)), variable(("in", X1, X2)), value(variable(("in", X1, X2)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_precondition("load-truck", ("in", par1, par2), true)).
repair(delete_precondition("load-truck", ("at", par2, par3), true)).
deleted_precondition(action(("load-truck", X1, X2, X3)), variable(("at", X2, X3)), value(variable(("at", X2, X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(delete_precondition("load-truck", ("at", par2, par3), true)).
repair(delete_precondition("load-truck", ("at", par1, par3), true)).
deleted_precondition(action(("load-truck", X1, X2, X3)), variable(("at", X1, X3)), value(variable(("at", X1, X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(delete_precondition("load-truck", ("at", par1, par3), true)).
repair(add_effect("load-truck", ("airport", par3), true)).
added_effect(action(("load-truck", X1, X2, X3)), variable(("airport", X3)), value(variable(("airport", X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_effect("load-truck", ("airport", par3), true)).
repair(add_effect("load-truck", ("at", par2, par3), true)).
added_effect(action(("load-truck", X1, X2, X3)), variable(("at", X2, X3)), value(variable(("at", X2, X3)), true)) :- action(action(("load-truck", X1, X2, X3))), enabled(add_effect("load-truck", ("at", par2, par3), true)).

