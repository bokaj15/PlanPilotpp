%---------------------------------------
% problem
%---------------------------------------

% objects
constant(constant("package2")).
has(constant("package2"), type("package")).

constant(constant("package1")).
has(constant("package1"), type("package")).

constant(constant("truck1")).
has(constant("truck1"), type("truck")).

constant(constant("plane1")).
has(constant("plane1"), type("airplane")).

constant(constant("city-1")).
has(constant("city-1"), type("location")).

constant(constant("city-2")).
has(constant("city-2"), type("location")).

constant(constant("city-3")).
has(constant("city-3"), type("location")).

constant(constant("city-4")).
has(constant("city-4"), type("location")).

constant(constant("city-5")).
has(constant("city-5"), type("location")).

constant(constant("city-6")).
has(constant("city-6"), type("location")).

% initial state
initialState(variable(("at", constant("plane1"), constant("city-2"))), value(variable(("at", constant("plane1"), constant("city-2"))), true)).
initialState(variable(("at", constant("truck1"), constant("city-1"))), value(variable(("at", constant("truck1"), constant("city-1"))), true)).
initialState(variable(("at", constant("package1"), constant("city-1"))), value(variable(("at", constant("package1"), constant("city-1"))), true)).
initialState(variable(("at", constant("package2"), constant("city-2"))), value(variable(("at", constant("package2"), constant("city-2"))), true)).
initialState(variable(("airport-in", constant("city-2"))), value(variable(("airport-in", constant("city-2"))), true)).
initialState(variable(("airport-in", constant("city-6"))), value(variable(("airport-in", constant("city-6"))), true)).
initialState(variable(("road", constant("city-1"), constant("city-2"))), value(variable(("road", constant("city-1"), constant("city-2"))), true)).
initialState(variable(("road", constant("city-2"), constant("city-3"))), value(variable(("road", constant("city-2"), constant("city-3"))), true)).
initialState(variable(("road", constant("city-3"), constant("city-4"))), value(variable(("road", constant("city-3"), constant("city-4"))), true)).
initialState(variable(("road", constant("city-4"), constant("city-5"))), value(variable(("road", constant("city-4"), constant("city-5"))), true)).
initialState(variable(("road", constant("city-5"), constant("city-6"))), value(variable(("road", constant("city-5"), constant("city-6"))), true)).

initialState(X, value(X, false)) :- variable(X), not initialState(X, value(X, true)).

% goal
goal(variable(("at", constant("package2"), constant("city-6"))), value(variable(("at", constant("package2"), constant("city-6"))), true)).
goal(variable(("at", constant("package1"), constant("city-6"))), value(variable(("at", constant("package1"), constant("city-6"))), true)).
